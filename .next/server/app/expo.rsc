13:["$","section",null,{"id":"experience","className":"section-white expo-experience","children":[["$","div",null,{"className":"shell expo-section-head","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow dark","children":"Experience"}],["$","h2",null,{"children":"Content Is Only One Part of the Expo."}]]}],["$","p",null,{"className":"section-intro","children":"Banking CEE Expo is designed around the conversations that happen between sessions — from focused one-to-one meetings and sponsor activations to informal networking and the evening programme."}]]}],["$","div",null,{"className":"shell expo-story-grid","children":[["$","figure",null,{"className":"story story-main","children":[["$","$L10",null,{"src":"/images/expo-business-2024.jpg","alt":"Banking CEE Expo business conversation","fill":true,"className":"cover"}],["$","figcaption",null,{"children":"Meaningful business conversations"}]]}],["$","figure",null,{"className":"story","children":[["$","$L10",null,{"src":"/images/expo-2025-tietoevry-activation.jpg","alt":"Banking CEE Expo technology partner activation","fill":true,"className":"cover"}],["$","figcaption",null,{"children":"Premium partner presence"}]]}],["$","figure",null,{"className":"story","children":[["$","$L10",null,{"src":"/images/expo-networking-2024.jpg","alt":"Banking CEE Expo networking","fill":true,"className":"cover"}],["$","figcaption",null,{"children":"Relationships beyond the stage"}]]}],["$","figure",null,{"className":"story story-wide","children":[["$","$L10",null,{"src":"/images/expo-2025-audience-applause.jpg","alt":"Banking CEE Expo audience","fill":true,"className":"cover"}],["$","figcaption",null,{"children":"A community that returns year after year"}]]}]]}],["$","div",null,{"className":"shell event-testimonial-wrap","children":["$","$L17",null,{"items":[["From vendors and bankers to speakers and panelists, the level of expertise throughout the event is truly premium. Combined with a high standard of organizati