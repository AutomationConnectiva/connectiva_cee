13:["$","section",null,{"id":"experience","className":"section-white summit-experience","children":[["$","div",null,{"className":"shell summit-section-head","children":[["$","div",null,{"children":[["$","p",null,{"className":"eyebrow dark","children":"Experience"}],["$","h2",null,{"children":"More Space for the Conversations That Matter."}]]}],["$","p",null,{"className":"section-intro","children":"The Summit is deliberately smaller and more personal than the Expo. Networking is not a break between sessions — it is a core part of the experience."}]]}],["$","div",null,{"className":"shell summit-story-grid","children":[["$","figure",null,{"className":"summit-story summit-story-main","children":[["$","$L10",null,{"src":"/images/summit-2026-one-to-one.jpg","alt":"One-to-one meeting at the Digital Banking CEE Summit","fill":true,"className":"cover"}],["$","figcaption",null,{"children":"Focused one-to-one conversations"}]]}],["$","figure",null,{"className":"summit-story","children":[["$","$L10",null,{"src":"/images/summit-2026-community.jpg","alt":"Digital Banking CEE Summit community","fill":true,"className":"cover"}],["$","figcaption",null,{"children":"A senior regional community"}]]}],["$","figure",null,{"className":"summit-story","children":[["$","$L10",null,{"src":"/images/summit-2026-audience.jpg","alt":"Digital Banking CEE Summit audience","fill":true,"className":"cover"}],["$","figcaption",null,{"children":"Engaged, practical discussion"}]]}],["$","figure",null,{"className":"summit-story summit-story-wide","children":[["$","$L10",null,{"src":"/images/summit-2026-human.jpg","alt":"Digital Banking CEE Summit participants sharing a relaxed moment","fill":true,"className":"cover"}],["$","figcaption",null,{"children":"Relationships beyond the programme"}]]}]]}],["$","div",null,{"className":"shell event-testimonial-wrap","children":["$","$L17",null,{"items":[["From vendors and bankers to speakers and panelists, the level of expertise throughout the event is truly premium. Combined with a high standard of organization, it delivers a consistently top-quality experience.","Danijela Vuksanović","Addiko Bank"],["After four years with Banking CEE, what stands out most is the evolution. This year’s event was excellent, with highly relevant topics.","Lyubomir Tankishev","Evrotrust"],["An outstanding event in every aspect — from organization and venue to accommodation, networking and speakers. A truly well-rounded, high-quality experience.","Daniela Bobocea","Exim Banca Românească"],["It was very positive. I could see that many of the people had attended multiple Banking CEE events. There’s a small community of people who are actually friends these days.","Donal Greene","Authologic"]]}]}]]}]
